# Copy to .env and fill in. Never commit .env.
PORT=10000
NODE_ENV=development
DATABASE_URL=postgres://dbuser:password@localhost:5432/appdb

# Long random string used to sign the session cookie
SESSION_SECRET=change-me

# OAuth client ID from Google Cloud Console (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Frontend origin allowed to call the API with cookies (CORS)
FRONTEND_URL=http://localhost:5173

# Nominatim (address search) requires a User-Agent that identifies the app; adding a contact
# e-mail is recommended. Usage policy: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=LostAndFound-FER-student-project
# Optional: another Nominatim server, and the countries address search is limited to
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_COUNTRY_CODES=hr
