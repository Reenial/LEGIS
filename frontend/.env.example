# Copy to .env.local for local development. VITE_* values end up in the browser bundle,
# so never put secrets here.

# Leave empty: the app calls /api on its own origin. `npm run dev` proxies it to
# http://localhost:10000 (vite.config.js) and nginx proxies it in Docker/Render.
# Set it only to call a backend directly (its session cookie will then be cross-site).
VITE_API_URL=
# Same OAuth client ID as the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
