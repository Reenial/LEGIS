@startuml
left to right direction

title Lost & Found - Use Case Diagram

skinparam backgroundColor White
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 30
skinparam ranksep 55
skinparam ArrowColor #505850

skinparam usecase {
  BackgroundColor #24476B
  BorderColor #18324D
  FontColor White
}

skinparam actor {
  BackgroundColor #F5F5F5
  BorderColor #666666
  FontColor #333333
  BackgroundColor<<external>> #ECEFF1
  BorderColor<<external>> #78909C
}

skinparam rectangle {
  BackgroundColor White
  BorderColor #24476B
  FontStyle bold
}

actor "Visitor" as Visitor
actor "Signed-in\nuser" as User
actor "Administrator" as Admin

rectangle "Lost & Found" {
  usecase "Browse, search\nand filter posts" as Browse
  usecase "View post details" as Details
  usecase "Sign in" as Login

  usecase "Post a lost or\nfound item" as Publish
  usecase "Edit own post" as Edit
  usecase "Remove own post" as Remove

  usecase "Request item return" as Request
  usecase "Accept or reject\na return request" as Review
  usecase "Track request status" as Status
  usecase "Exchange\nprivate messages" as Messages

  usecase "View possible\nmatches" as Matches
  usecase "Enable notifications and view\nmatch notifications" as Notifications

  usecase "Report\na problematic post" as Report
  usecase "Review reports and remove\ninappropriate content" as Moderate
}

actor "OAuth identity\nprovider" as Identity <<external>>
actor "Map service" as Maps <<external>>

User --|> Visitor

Visitor -- Browse
Visitor -- Details
Visitor -- Login

User -- Publish
User -- Edit
User -- Remove
User -- Request
User -- Review
User -- Status
User -- Messages
User -- Matches
User -- Notifications
User -- Report

Admin -- Login
Admin -- Moderate

Login -- Identity
Details -- Maps
Publish -- Maps
Edit -- Maps

@enduml
