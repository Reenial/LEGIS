# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template).
# API_UPSTREAM: backend base URL, e.g. https://api-service.onrender.com or http://backend:10000
# NGINX_LOCAL_RESOLVERS: filled in by the image because the Dockerfile sets NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
server {
    listen 80;
    server_name localhost;

    # Re-resolve the backend host instead of caching its IP for the container's lifetime.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    # The browser only talks to this origin; nginx forwards /api to the backend.
    # This keeps the session cookie (lf.sid) first-party, so browsers that block
    # third-party cookies (Safari, Chrome with the setting on) still keep users signed in.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;            # no URI part: the original /api/... path is kept
        proxy_ssl_server_name on;            # send SNI when the backend is https
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # X-Forwarded-Proto from Render's edge (https) passes through unchanged; the backend
        # needs it to set the Secure session cookie, so don't overwrite it with nginx's own http.
        proxy_read_timeout 60s;              # free Render services can take a while to wake up
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }
}
